# axiosInstance.ts 는 이 값이 없으면 모듈 로드 시점에 throw 한다.
# 없으면 앱이 실행 즉시 죽는다.
EXPO_PUBLIC_API_BASE_URL=

# 네이버 지도 (app.config.ts 플러그인에서 사용). 없으면 지도가 빈 화면.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# "true" 면 src/api/**/*.index.ts 가 전부 목 데이터로 붙는다.
# production 빌드에 절대 true 로 나가면 안 된다 — tests/env-guard.test.ts 가 막는다.
EXPO_PUBLIC_USE_MOCK=false

#androidAppID
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=

EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=